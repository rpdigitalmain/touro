{
  "name": "touro",
  "version": "0.1.0",
  "description": "An image optimization CLI for Linux and Windows",
  "type": "module",
  "bin": {
    "touro": "bin/touro.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": ["linux", "win32"],
  "scripts": {
    "dev": "node bin/touro.js",
    "clean": "node -e \"for (const d of ['dist-exe','build']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "test": "node --test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.js\"",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "keywords": [
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
