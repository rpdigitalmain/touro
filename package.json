{
  "name": "touro",
  "version": "0.1.0",
  "description": "An image optimization CLI for Linux and Windows",
  "type": "module",
  "bin": {
    "touro": "bin/touro.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": ["linux", "win32"],
  "scripts": {
    "dev": "node bin/touro.js",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const directory of ['dist-exe', 'build']) rmSync(directory, { recursive: true, force: true })\"",
    "test": "node --test",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/**/*.test.js\"",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "keywords": [
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
